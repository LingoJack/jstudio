# TypeScript incremental build cache
*.tsbuildinfo

# Do not commit TypeScript compiled output — Vite resolves .js before .ts,
# so stale .js shadows the .ts source. Keep .config.js (vite/tailwind/etc).
src/**/*.js
src/**/*.js.map
!src/**/*.config.js
