{"id": "doc-put-snapshot", "requirement": "req-2026-0910-remote-save", "title": "上传一份文档快照（远程保存）", "module": "documents", "method": "PUT", "path": "/api/v1/documents/:docId", "status": "implemented", "auth": "bearer", "owner": "jack", "created": "2026-09-08", "updated": "2026-09-10", "background": "桌面端只有本地文件，换机器就丢；需要一个按 docId 追加快照的写入口，服务端保留历史版本供回看", "expected": "每次调用追加一个新快照，revision 从 1 起自增，绝不覆盖旧快照；同一 docId 首次调用即建档；body 原样存储不解析结构，因此桌面端文档格式演进不需要改后端；成功返回新快照的 revision 与字节数", "request": {"headers": {"type": "object", "properties": {"Authorization": {"type": "string", "description": "Bearer <access token>，缺失或过期按未登录处理"}}, "required": ["Authorization"]}, "path_params": {"type": "object", "properties": {"docId": {"type": "string", "description": "文档标识，由桌面端生成的稳定 id，作用域是当前用户"}}, "required": ["docId"]}, "body": {"type": "object", "properties": {"title": {"type": "string", "description": "文档标题，仅用于列表展示，可为空串"}, "body": {"type": "object", "additionalProperties": true, "description": "文档正文的完整 JSON，服务端原样落库不校验内部结构，上限 8MiB（含字段名）"}}, "required": ["body"]}}, "response": {"success": {"http_status": 201, "schema": {"type": "object", "properties": {"doc_id": {"type": "string", "description": "回显的文档标识，与请求路径一致"}, "revision": {"type": "integer", "description": "本次写入产生的快照版本号，从 1 起自增"}, "size_bytes": {"type": "integer", "description": "本次 body 落库后的字节数"}, "created_at": {"type": "string", "description": "快照写入时间，RFC3339"}}, "required": ["doc_id", "revision", "size_bytes", "created_at"]}}}, "errors": [{"code": "INVALID_REQUEST", "http_status": 400, "message": "invalid json body", "when": "body 不是合法 JSON，或 body 字段缺失/为空"}, {"code": "PAYLOAD_TOO_LARGE", "http_status": 413, "message": "document body too large", "when": "请求体超过 8MiB"}, {"code": "UNAUTHORIZED", "http_status": 401, "message": "unauthorized", "when": "缺 Authorization 头或 token 解析失败"}, {"code": "INTERNAL", "http_status": 500, "message": "internal server error", "when": "落库失败等服务端异常，细节只进服务端日志不返回客户端"}], "impl": {"handler": "backend/internal/api/documents_handler.go:36", "verified": "2026-09-10", "notes": "字段名、状态码、四个错误码已与 handler 逐条核对一致"}}
{"id": "doc-snapshot-list", "requirement": "req-2026-0910-remote-save", "title": "列出一份文档的快照历史", "module": "documents", "method": "GET", "path": "/api/v1/documents/:docId/snapshots", "status": "implemented", "auth": "bearer", "owner": "jack", "created": "2026-09-09", "updated": "2026-09-10", "background": "远程保存写入历史后，桌面端要能看到有哪些版本可回看，只需要元信息不需要正文", "expected": "按 revision 倒序返回快照元信息，只含 revision/大小/时间，不含正文；limit 缺省 50，超过 200 按 200 截断而不报错；total 是该文档快照总数，与本次返回条数无关；文档不存在返回 404", "request": {"headers": {"type": "object", "properties": {"Authorization": {"type": "string", "description": "Bearer <access token>"}}, "required": ["Authorization"]}, "path_params": {"type": "object", "properties": {"docId": {"type": "string", "description": "文档标识，作用域是当前用户"}}, "required": ["docId"]}, "query": {"type": "object", "properties": {"limit": {"type": "integer", "description": "返回条数上限，缺省 50，最大 200（超出按 200 截断），必须为正整数"}}, "required": []}}, "response": {"success": {"http_status": 200, "schema": {"type": "object", "properties": {"total": {"type": "integer", "description": "该文档的快照总数，不受 limit 影响"}, "snapshots": {"type": "array", "description": "快照元信息，按 revision 倒序", "items": {"type": "object", "properties": {"revision": {"type": "integer", "description": "快照版本号"}, "size_bytes": {"type": "integer", "description": "该快照正文字节数"}, "created_at": {"type": "string", "description": "写入时间，RFC3339"}}, "required": ["revision", "size_bytes", "created_at"]}}}, "required": ["total", "snapshots"]}}}, "errors": [{"code": "INVALID_REQUEST", "http_status": 400, "message": "limit must be a positive integer", "when": "limit 不是正整数"}, {"code": "NOT_FOUND", "http_status": 404, "message": "document not found", "when": "docId 不存在，或不属于当前用户"}, {"code": "UNAUTHORIZED", "http_status": 401, "message": "unauthorized", "when": "缺 Authorization 头或 token 解析失败"}, {"code": "INTERNAL", "http_status": 500, "message": "internal server error", "when": "查询失败等服务端异常"}], "impl": {"handler": "backend/internal/api/documents_handler.go:94", "verified": "2026-09-10", "notes": "limit 截断行为在契约里写明，避免调用方以为超限会报错"}}
