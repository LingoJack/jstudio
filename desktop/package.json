{
  "name": "jstudio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "JStudio local knowledge graph desktop app (Electron + Rust sidecar).",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc -b",
    "electron:build:main": "esbuild electron/main.ts electron/preload.ts electron/sidecar.ts --bundle --platform=node --format=cjs --external:electron --out-extension:.js=.cjs --outdir=dist-electron",
    "electron:build:sidecar": "cargo build --manifest-path src-tauri/Cargo.toml --bin jstudio-sidecar",
    "electron:build:sidecar:release": "cargo build --release --manifest-path src-tauri/Cargo.toml --bin jstudio-sidecar",
    "electron:build": "npm run build && npm run electron:build:main && npm run electron:build:sidecar:release && electron-builder",
    "test:sidecar": "node scripts/sidecar-smoke.mjs",
    "electron:dev": "npm run electron:build:main && npm run electron:build:sidecar && concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:1420 && electron .\"",
    "knip": "knip",
    "lint:tsc": "tsc --noEmit",
    "lint:struct": "npm run lint:tsc && npm run knip",
    "test:shortcuts": "tsx --test src/lib/shortcuts/keyboardShortcuts.test.ts src/lib/core/commandRegistry.test.ts",
    "test:cursor": "tsx --test src/components/editor/CursorTrailContext.test.ts",
    "test:adapter": "tsx --test src/lib/editor/tiptapAdapter/tiptapAdapter.roundtrip.test.ts",
    "test:remote": "tsx --test src/lib/remote/client.test.ts",
    "test": "tsx --test src/lib/shortcuts/keyboardShortcuts.test.ts src/lib/core/commandRegistry.test.ts src/components/editor/CursorTrailContext.test.ts src/lib/editor/mermaid/flowchartConverter.test.ts src/components/editor/nodes/graph/sequenceInteraction.test.ts src/lib/editor/tiptapAdapter/tiptapAdapter.roundtrip.test.ts src/lib/editor/pasteMarkdown.test.ts src/lib/remote/client.test.ts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@maxgraph/core": "^0.23.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tiptap/core": "^3.26.0",
    "@tiptap/extension-code": "^3.27.1",
    "@tiptap/extension-code-block-lowlight": "^3.26.0",
    "@tiptap/extension-color": "^3.26.0",
    "@tiptap/extension-image": "^3.26.0",
    "@tiptap/extension-link": "^3.26.0",
    "@tiptap/extension-list": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.26.0",
    "@tiptap/extension-table": "^3.26.0",
    "@tiptap/extension-table-cell": "^3.26.0",
    "@tiptap/extension-table-header": "^3.26.0",
    "@tiptap/extension-table-row": "^3.26.0",
    "@tiptap/extension-text-align": "^3.26.0",
    "@tiptap/extension-text-style": "^3.26.0",
    "@tiptap/extension-underline": "^3.26.0",
    "@tiptap/markdown": "^3.26.0",
    "@tiptap/pm": "^3.26.0",
    "@tiptap/react": "^3.26.0",
    "@tiptap/starter-kit": "^3.27.1",
    "@tiptap/suggestion": "^3.26.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@xterm/addon-fit": "^0.12.0-beta.287",
    "@xterm/addon-serialize": "^0.15.0-beta.287",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.20.0-beta.286",
    "@xterm/xterm": "^6.1.0-beta.287",
    "katex": "^0.16.47",
    "linkifyjs": "^4.3.3",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.0",
    "pdfjs-dist": "^5.4.296",
    "pinyin-pro": "^3.28.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "remark-gfm": "^4.0.1",
    "tippy.js": "^6.3.7",
    "vite": "^6.2.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "knip": "^6.26.0",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "wait-on": "^9.1.0"
  }
}
